# --- Observabilidad ---
SERVICE_NAME=rag-ingest-eventarc
SERVICE_VERSION=1.0.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Backend: memory (demo, sin credenciales) | gcp (Firestore + Gemini) ---
BACKEND=memory
DEMO_TENANTS=demo              # solo backend memory

# --- Producción (requirements-gcp.txt) ---
GCP_PROJECT=
GEMINI_API_KEY=                # inyectar desde un gestor de secretos; nunca versionar
ALLOWED_BUCKET=                # si se define, se ignoran eventos de otros buckets

# --- Import (long-running operation) ---
IMPORT_POLL_ATTEMPTS=30
IMPORT_POLL_INTERVAL_SECONDS=2
